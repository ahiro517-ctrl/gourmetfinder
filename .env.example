# ローカルで本番実行を試すとき用のサンプル。
# 実際の値を入れて「.env」にコピーして使います（.env は git に入りません）。
# ※ ふだんは GitHub Actions の Secrets に登録するので、このファイルは無くてもOKです。

# Google Places APIキー
GOOGLE_PLACES_API_KEY=ここにAPIキー

# サービスアカウントのJSON（中身を1行で貼り付け、もしくはファイルから読み込ませる）
GOOGLE_SERVICE_ACCOUNT_JSON=

# 提案を書き込むスプレッドシートのID（URLの /d/ と /edit の間の文字列）
GOURMET_SPREADSHEET_ID=
